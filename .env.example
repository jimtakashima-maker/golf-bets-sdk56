# Firebase config for golf-bets-sdk56.
#
# 1. Create a free project at https://console.firebase.google.com
# 2. Add a Web app to it (the </> icon on the project overview page)
# 3. Build > Realtime Database > Create Database (any region is fine, start
#    in locked mode)
# 4. Build > Authentication > Sign-in method > enable "Anonymous"
# 5. In Realtime Database > Rules, paste the contents of database.rules.json
# 6. In Project settings > General > Your apps > (your web app) > SDK setup
#    and configuration, copy each value out of the firebaseConfig object
#    Firebase gives you into a new file named .env in this same folder
#    (not this .env.example file) and fill them in below.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Gemini API key, used to read par/handicap-index off a scanned scorecard
# photo (see src/lib/gemini.ts). Get a free key at https://aistudio.google.com
# with the same Google account as your Firebase project - click "Get API key".
#
# NOTE: this ships inside the app bundle, which is fine for testing with a
# small group but should move behind a backend (e.g. a Firebase Cloud
# Function) before any public App Store release.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional: override the Gemini model used for scorecard scanning. Defaults
# to gemini-2.5-flash if unset. Check https://ai.google.dev/gemini-api/docs/models
# for the current lineup if you want to try a newer/cheaper one.
EXPO_PUBLIC_GEMINI_MODEL=

# Sentry DSN, used for crash reporting and performance monitoring (see
# src/lib/sentry.ts). Optional - if left blank, Sentry is simply never
# initialized and the app behaves exactly as before.
#
# 1. Create a free account/project at https://sentry.io (choose
#    "React Native" as the platform)
# 2. Project Settings > Client Keys (DSN) > copy the DSN into .env below
#
# Separately, for real (non-minified) stack traces in Sentry, EAS builds
# need to upload source maps at build time, which requires a Sentry auth
# token set as a *build secret* (never in this file, since it grants write
# access to the whole Sentry org - org/project themselves are just
# "apex-approach-advisory" / "react-native", already set in app.json's
# Sentry plugin config since those aren't secret). Get a token under
# Settings > Auth Tokens in Sentry, then:
#   eas env:create --name SENTRY_AUTH_TOKEN --value <token> --visibility secret
EXPO_PUBLIC_SENTRY_DSN=
